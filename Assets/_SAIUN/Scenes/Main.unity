  steps:
  - title: "\uCE90\uB9AD\uD130 \uC124\uC815"
    body: "\uC624\uB978\uCABD \uC704 \uAE30\uC5B4 \uC544\uC774\uCF58\uC5D0\uC11C
      \uCE90\uB9AD\uD130\uB97C \uBC14\uAFC0 \uC218 \uC788\uC5B4\uC694.\n\uAE30\uBCF8
      \uCE90\uB9AD\uD130\uB85C \uC2DC\uC791\uD574\uB3C4 \uAD1C\uCC2E\uC544\uC694."
    target: {fileID: 983229399}
  - title: "\uC791\uBB3C \uC2EC\uAE30"
    body: "\uC2DC\uC791 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uC138\uC158 \uC124\uC815\uC774
      \uC5F4\uB824\uC694.\n\uC791\uBB3C \uBAA9\uB85D\uC5D0\uC11C \uC2EC\uC744 \uC791\uBB3C\uC744
      \uACE0\uB974\uC138\uC694."
    target: {fileID: 1891241837}
  - title: "\uD3EC\uBAA8\uB3C4\uB85C \uC2DC\uC791"
    body: "\uC9D1\uC911 \uC2DC\uAC04\uACFC \uC138\uD2B8 \uC218\uB97C \uC815\uD558\uACE0
      \uC2DC\uC791\uD558\uC138\uC694.\n\uC9D1\uC911 \uC911\uC5D0 \uBC29\uD574 \uC571\uC73C\uB85C
      \uB118\uC5B4\uAC00 \uC720\uC608 \uC2DC\uAC04 \uC548\uC5D0 \uB3CC\uC544\uC624\uC9C0
      \uC54A\uC73C\uBA74 \uC791\uBB3C\uC774 \uC2DC\uB4E4\uC5B4\uC694."
    target: {fileID: 1891241837}
  stepFormat: '{0} / {1}'
