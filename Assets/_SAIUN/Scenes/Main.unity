  m_Script: {fileID: 11500000, guid: 5687732b492af1545b7c85197d3866e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: _SAIUN.Scripts::_SAIUN.Scripts.UI.TutorialView
  gameManager: {fileID: 215741472}
  overlay: {fileID: 1514252577}
  stepText: {fileID: 217466655}
  titleText: {fileID: 1758672742}
  bodyText: {fileID: 40910186}
  nextButton: {fileID: 845760722}
  nextLabel: {fileID: 1261362352}
  skipButton: {fileID: 2078536796}
  highlight: {fileID: 735640343}
  steps:
  - title: "\uBC29\uD574 \uC571 \uB4F1\uB85D"
    body: "\uC624\uB978\uCABD \uC704 \uAE30\uC5B4 \uC544\uC774\uCF58\uC5D0\uC11C
      \uC9D1\uC911\uC744 \uBC29\uD574\uD558\uB294 \uC571\uC744 \uB4F1\uB85D\uD558\uC138\uC694.\n\uB0A0\uC528\xB7\uCC3D\xB7\uC18C\uB9AC\uB3C4
      \uC5EC\uAE30\uC11C \uBC14\uAFC0 \uC218 \uC788\uC5B4\uC694."
    target: {fileID: 585433129}
  - title: "\uC62C\uB9AC\uBE0C \uD0A4\uC6B0\uAE30"
    body: "\uC26C\uB294 \uB3D9\uC548 \uC0C1\uC790\uC5D0\uC11C\uB294 \uD143\uBC2D
      \uC791\uBB3C\uC774 \uC800\uC808\uB85C \uC790\uB77C\uC694.\n\uC9D1\uC911\uC744
      \uC2DC\uC791\uD558\uBA74 \uD654\uBD84\uC5D0 \uC62C\uB9AC\uBE0C\uB97C \uC2EC\uACE0,
      \uC138\uD2B8\uB97C \uB9C8\uCE60\uC218\uB85D \uC790\uB77C \uC5F4\uB9E4\uAC00
      \uC775\uC5B4\uC694."
    target: {fileID: 341622329}
  - title: "\uD3EC\uBAA8\uB3C4\uB85C \uC2DC\uC791"
    body: "\uC9D1\uC911 \uC2DC\uAC04\uACFC \uC138\uD2B8 \uC218\uB97C \uC815\uD558\uACE0
      \uC2DC\uC791\uD558\uC138\uC694.\n\uC9D1\uC911 \uC911\uC5D0 \uBC29\uD574 \uC571\uC73C\uB85C
      \uB118\uC5B4\uAC00 \uC720\uC608 \uC2DC\uAC04 \uC548\uC5D0 \uB3CC\uC544\uC624\uC9C0
      \uC54A\uC73C\uBA74 \uC62C\uB9AC\uBE0C\uAC00 \uC2DC\uB4E4\uC5B4\uC694."
    target: {fileID: 341622329}
  stepFormat: '{0} / {1}'
  nextText: "\uB2E4\uC74C"
  finishText: "\uC2DC\uC791\uD558\uAE30"
  highlightPadding: 6
